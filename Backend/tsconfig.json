{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noImplicitAny": true,
    "module": "node16",
    "strict": true,
    "target": "ES6",
    "allowJs": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
