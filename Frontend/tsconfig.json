{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noImplicitAny": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@public/*": ["./public/*"]
    },
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "bundler"
    },
    "moduleTypes": {
      "webpack.config.ts": "cjs",
      "config/build/**/*": "cjs"
    }
  },
  "include": ["src", "*.config.ts"]
}
